# Port 80 on the bare IP belongs to the repair site (masterprorab.ru and 109.172.37.155).
# Do not attach that address to this app, and do not enable nginx.
# Names without an http:// prefix make Caddy obtain a certificate and redirect HTTP to HTTPS.
# Port 8080 stays as a temporary address on the existing Caddy container.

documentmigrant.ru, www.documentmigrant.ru {
	encode gzip
	reverse_proxy 172.18.0.1:8787
}

http://:8080 {
	encode gzip
	reverse_proxy 172.18.0.1:8787
}
