# Port 80 on this host is already Caddy. Do not enable nginx.
# The public IP serves this app over HTTP with no extra Host header.
# While documentmigrant.ru has no DNS, keep the http:// prefix on the names.
# After the A records answer, drop http:// from the domain names only and restart Caddy.

http://109.172.37.155, http://documentmigrant.ru, http://www.documentmigrant.ru {
	encode gzip
	reverse_proxy 172.18.0.1:8787
}
